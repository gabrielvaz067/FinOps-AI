FROM python:3.14-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY backend/requirements.lock.txt ./requirements.lock.txt
RUN pip install --no-cache-dir -r requirements.lock.txt && useradd --uid 10001 --create-home finops

COPY backend/ ./backend/
COPY database/alembic.ini ./database/alembic.ini
COPY database/migrations/ ./database/migrations/
RUN chown -R finops:finops /app

USER finops
EXPOSE 10000
CMD ["sh", "-c", "if [ \"${PUBLIC_DEMO:-}\" != \"true\" ] || [ -z \"${DATABASE_URL:-}\" ]; then echo 'PUBLIC_DEMO=true and DATABASE_URL are required' >&2; exit 1; fi; python -m backend.app.cli migrate && exec uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
