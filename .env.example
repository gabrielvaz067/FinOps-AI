# Copy to .env; keep secrets on the backend only.
DATABASE_URL=sqlite:///./database/finops.db
FINOPS_ADMIN_KEY=
# true removes write routes and the n8n pending endpoint; use only with a seeded database.
PUBLIC_DEMO=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Rules are the default. Gemini is invoked only by an authenticated user action.
NOTIFICATION_MODE=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# Docker Compose only: set these before starting the integrated profile.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

